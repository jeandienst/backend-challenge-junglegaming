{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit/money.test.ts tests/integration/concurrency.test.ts tests/integration/sqs.test.ts",
    "test:unit": "bun test tests/unit/money.test.ts",
    "test:integration": "bun test tests/integration/concurrency.test.ts tests/integration/sqs.test.ts",
    "migration:up": "bun run src/migrations/up.ts",
    "migration:down": "bun run src/migrations/down.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.900.0",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/postgresql": "^6.4.16",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
